# Credentials for tools/remote-build.sh (build images on the Hetzner box from
# your laptop). Copy this file:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. NEVER commit it. One KEY=VALUE per line; quote values
# that contain spaces ("like this"); no inline comments after a value.

# --- Hetzner build box -------------------------------------------------------
HETZNER_HOST=1.2.3.4
HETZNER_USER=root
HETZNER_PORT=22
HETZNER_PASSWORD=change-me
# Optional: log in with an SSH key instead of the password (path to the
# PRIVATE key). When set, HETZNER_PASSWORD is ignored.
#HETZNER_SSH_KEY=~/.ssh/id_ed25519

# --- Docker Hub (required: build.sh pushes the images here) ------------------
DOCKERHUB_USERNAME=jmendapara
DOCKERHUB_TOKEN=dckr_pat_xxx

# --- Download tokens (optional; forwarded to the build as BuildKit secrets) --
HUGGINGFACE_ACCESS_TOKEN=
CIVITAI_TOKEN=

# --- build.sh overrides (optional; defaults shown) ---------------------------
# Branch the box clones and builds. Default: the branch you currently have
# checked out (it must be pushed to origin).
#BRANCH=main
#IMAGE_NAMESPACE=jmendapara
#BASE_TAG=2026-01-01-1200-abc1234
#COMFYUI_VERSION=latest
#NO_PUSH=1
#REPO_URL=https://github.com/Jmendapara/runpod-workers.git

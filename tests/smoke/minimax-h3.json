{
  "_NOTE": "MiniMax H3 text-to-video smoke (768x768, 5s/124f, turbo 8-step, stereo audio). run_smoke.py wraps this object as {\"input\": ...}; wrap it yourself if POSTing directly to the RunPod endpoint. Expect one H.264 MP4 under output.videos. Requires a ComfyUI >= 0.30 + cu130 base.",
  "workflow": {
    "1": {
      "inputs": {
        "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "Load Diffusion Model"
      }
    },
    "2": {
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "Load CLIP"
      }
    },
    "3": {
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Load Video VAE"
      }
    },
    "4": {
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Load Audio VAE"
      }
    },
    "5": {
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
        "strength_model": 1
      },
      "class_type": "LoraLoaderModelOnly",
      "_meta": {
        "title": "Turbo LoRA (8 step)"
      }
    },
    "7": {
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "prompt": "A golden retriever puppy runs through tall grass at sunset, slow motion, gentle wind. Audio: rustling grass, birds chirping, a soft warm piano melody.",
        "width": 768,
        "height": 768,
        "length": 124
      },
      "class_type": "MiniMaxH3ImageToVideo",
      "_meta": {
        "title": "MiniMax H3 (text-to-video)"
      }
    },
    "8": {
      "inputs": {
        "noise_seed": 42
      },
      "class_type": "RandomNoise",
      "_meta": {
        "title": "RandomNoise"
      }
    },
    "9": {
      "inputs": {
        "sampler_name": "res_multistep"
      },
      "class_type": "KSamplerSelect",
      "_meta": {
        "title": "KSamplerSelect"
      }
    },
    "10": {
      "inputs": {
        "model": [
          "5",
          0
        ],
        "scheduler": "simple",
        "steps": 8,
        "denoise": 1
      },
      "class_type": "BasicScheduler",
      "_meta": {
        "title": "BasicScheduler"
      }
    },
    "11": {
      "inputs": {
        "model": [
          "5",
          0
        ],
        "conditioning": [
          "7",
          0
        ]
      },
      "class_type": "BasicGuider",
      "_meta": {
        "title": "BasicGuider"
      }
    },
    "12": {
      "inputs": {
        "noise": [
          "8",
          0
        ],
        "guider": [
          "11",
          0
        ],
        "sampler": [
          "9",
          0
        ],
        "sigmas": [
          "10",
          0
        ],
        "latent_image": [
          "7",
          1
        ]
      },
      "class_type": "SamplerCustomAdvanced",
      "_meta": {
        "title": "SamplerCustomAdvanced"
      }
    },
    "13": {
      "inputs": {
        "samples": [
          "12",
          0
        ],
        "vae": [
          "3",
          0
        ]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode (video)"
      }
    },
    "14": {
      "inputs": {
        "samples": [
          "12",
          0
        ],
        "vae": [
          "4",
          0
        ]
      },
      "class_type": "VAEDecodeAudio",
      "_meta": {
        "title": "VAE Decode (audio)"
      }
    },
    "15": {
      "inputs": {
        "images": [
          "13",
          0
        ],
        "fps": 24,
        "audio": [
          "14",
          0
        ]
      },
      "class_type": "CreateVideo",
      "_meta": {
        "title": "Create Video"
      }
    },
    "16": {
      "inputs": {
        "filename_prefix": "video/MiniMax_H3",
        "format": "mp4",
        "codec": "h264",
        "video": [
          "15",
          0
        ]
      },
      "class_type": "SaveVideo",
      "_meta": {
        "title": "Save Video"
      }
    }
  }
}

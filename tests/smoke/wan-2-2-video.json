{
  "_NOTE": "Small 480x480, 17-frame clip from a plain gradient: high + low noise passes, the speed LoRA and RIFE x2. Generated from pixel-dream server/models/wan-2-2-video.js. Does not load the NSFW LoRA pair.",
  "workflow": {
    "clip": {
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "Text encoder"
      }
    },
    "vae": {
      "inputs": {
        "vae_name": "wan_2.1_vae.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "VAE"
      }
    },
    "unet_high": {
      "inputs": {
        "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "High noise model"
      }
    },
    "unet_low": {
      "inputs": {
        "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "Low noise model"
      }
    },
    "positive": {
      "inputs": {
        "text": "A pale sun drifts slowly across a warm evening sky. The camera holds a static shot.",
        "clip": [
          "clip",
          0
        ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Prompt"
      }
    },
    "negative": {
      "inputs": {
        "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
        "clip": [
          "clip",
          0
        ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative prompt"
      }
    },
    "load_image": {
      "inputs": {
        "image": "input_image_0.png"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Start frame"
      }
    },
    "i2v": {
      "inputs": {
        "positive": [
          "positive",
          0
        ],
        "negative": [
          "negative",
          0
        ],
        "vae": [
          "vae",
          0
        ],
        "width": 480,
        "height": 480,
        "length": 17,
        "batch_size": 1,
        "start_image": [
          "load_image",
          0
        ]
      },
      "class_type": "WanImageToVideo",
      "_meta": {
        "title": "Image to video"
      }
    },
    "low_lora_0": {
      "inputs": {
        "model": [
          "unet_low",
          0
        ],
        "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
        "strength_model": 1
      },
      "class_type": "LoraLoaderModelOnly",
      "_meta": {
        "title": "LoRA low 1"
      }
    },
    "shift_high": {
      "inputs": {
        "model": [
          "unet_high",
          0
        ],
        "shift": 5
      },
      "class_type": "ModelSamplingSD3",
      "_meta": {
        "title": "Shift (high)"
      }
    },
    "shift_low": {
      "inputs": {
        "model": [
          "low_lora_0",
          0
        ],
        "shift": 5
      },
      "class_type": "ModelSamplingSD3",
      "_meta": {
        "title": "Shift (low)"
      }
    },
    "sample_high": {
      "inputs": {
        "model": [
          "shift_high",
          0
        ],
        "add_noise": "enable",
        "noise_seed": 1,
        "steps": 10,
        "cfg": 3.5,
        "sampler_name": "euler",
        "scheduler": "simple",
        "positive": [
          "i2v",
          0
        ],
        "negative": [
          "i2v",
          1
        ],
        "latent_image": [
          "i2v",
          2
        ],
        "start_at_step": 0,
        "end_at_step": 4,
        "return_with_leftover_noise": "enable"
      },
      "class_type": "KSamplerAdvanced",
      "_meta": {
        "title": "Sampler (high noise)"
      }
    },
    "sample_low": {
      "inputs": {
        "model": [
          "shift_low",
          0
        ],
        "add_noise": "disable",
        "noise_seed": 0,
        "steps": 10,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "positive": [
          "i2v",
          0
        ],
        "negative": [
          "i2v",
          1
        ],
        "latent_image": [
          "sample_high",
          0
        ],
        "start_at_step": 4,
        "end_at_step": 10000,
        "return_with_leftover_noise": "disable"
      },
      "class_type": "KSamplerAdvanced",
      "_meta": {
        "title": "Sampler (low noise)"
      }
    },
    "decode": {
      "inputs": {
        "samples": [
          "sample_low",
          0
        ],
        "vae": [
          "vae",
          0
        ]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "Decode"
      }
    },
    "interp_model": {
      "inputs": {
        "model_name": "rife_v4.26.safetensors"
      },
      "class_type": "FrameInterpolationModelLoader",
      "_meta": {
        "title": "Frame interpolation model"
      }
    },
    "interp": {
      "inputs": {
        "interp_model": [
          "interp_model",
          0
        ],
        "images": [
          "decode",
          0
        ],
        "multiplier": 2
      },
      "class_type": "FrameInterpolate",
      "_meta": {
        "title": "Frame interpolation (x2)"
      }
    },
    "video": {
      "inputs": {
        "images": [
          "interp",
          0
        ],
        "fps": 32
      },
      "class_type": "CreateVideo",
      "_meta": {
        "title": "Create video"
      }
    },
    "save": {
      "inputs": {
        "video": [
          "video",
          0
        ],
        "filename_prefix": "video/wan22",
        "format": "mp4",
        "codec": "h264"
      },
      "class_type": "SaveVideo",
      "_meta": {
        "title": "Save video"
      }
    }
  },
  "images": [
    {
      "node_id": "load_image",
      "input_field": "image",
      "name": "input_image_0.png",
      "image": ""
    }
  ]
}
